{
  "name": "idea-capture-setup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cutroom:zip": "rm -f public/cut-room.zip && mkdir -p .zip/\"Cut Room\" && rsync -a --delete --exclude node_modules cutroom/ .zip/\"Cut Room\"/ && cd .zip && zip -qr ../public/cut-room.zip \"Cut Room\" && cd .. && rm -rf .zip"
  },
  "dependencies": {
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
